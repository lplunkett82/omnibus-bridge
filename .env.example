# Translator encryption keys (AES-128 private key, split into two halves).
# Each value is 16 hex characters, no separators. Obtain from:
#   - Translator web UI at http://192.0.2.10
#   - OMNIBUS Software -> Translator -> Network Setup
#   - OmniPro II keypad (if acting as config master)
OMNILINK_KEY1=
OMNILINK_KEY2=

# MQTT broker credentials
MQTT_USER=
MQTT_PASS=
